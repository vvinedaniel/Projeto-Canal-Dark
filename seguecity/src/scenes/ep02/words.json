{
 "fonte": "scripts/ep02-narracao.py",
 "frases": [
  {
   "id": "f01",
   "text": "Dez pessoas decidiram morar na minha cidade.",
   "a": 0.08,
   "b": 2.734
  },
  {
   "id": "f02",
   "text": "E uma delas escolheu ser coveiro numa cidade que nem tem cemitério.",
   "a": 3.173,
   "b": 7.249
  },
  {
   "id": "f03",
   "text": "Ontem, a SegueCity tinha zero moradores.",
   "a": 7.832,
   "b": 10.605
  },
  {
   "id": "f04",
   "text": "Hoje…",
   "a": 11.023,
   "b": 11.352
  },
  {
   "id": "f05",
   "text": "As primeiras dez casas ganharam seus donos.",
   "a": 11.593,
   "b": 14.158
  },
  {
   "id": "f06",
   "text": "Mateus, médico, foi o primeiro a chegar.",
   "a": 14.632,
   "b": 17.251
  },
  {
   "id": "f07",
   "text": "Nosso morador número um.",
   "a": 17.566,
   "b": 19.201
  },
  {
   "id": "f08",
   "text": "Davi assumiu a profissão de policial.",
   "a": 19.648,
   "b": 21.986
  },
  {
   "id": "f09",
   "text": "Gabriel e Juan ficaram responsáveis pela oficina mecânica.",
   "a": 22.393,
   "b": 25.802
  },
  {
   "id": "f10",
   "text": "Mari chegou como neurocirurgiã.",
   "a": 26.2,
   "b": 28.24
  },
  {
   "id": "f11",
   "text": "Alicia e Muri escolheram ser empresários.",
   "a": 28.543,
   "b": 31.043
  },
  {
   "id": "f12",
   "text": "Gabrielly será nossa advogada.",
   "a": 31.334,
   "b": 33.095
  },
  {
   "id": "f13",
   "text": "Jorge, nosso comerciante.",
   "a": 33.408,
   "b": 35.071
  },
  {
   "id": "f14",
   "text": "E Roberto…",
   "a": 35.379,
   "b": 36.265
  },
  {
   "id": "f15",
   "text": "nosso primeiro coveiro.",
   "a": 36.512,
   "b": 37.998
  },
  {
   "id": "f16",
   "text": "Mas temos um problema.",
   "a": 38.716,
   "b": 39.989
  },
  {
   "id": "f17",
   "text": "Onde o Roberto vai trabalhar?",
   "a": 40.433,
   "b": 41.755
  },
  {
   "id": "f18",
   "text": "Vamos reservar um terreno para construir o primeiro cemitério da cidade.",
   "a": 42.237,
   "b": 45.987
  },
  {
   "id": "f19",
   "text": "E outro para o escritório de advocacia da Gabrielly.",
   "a": 46.316,
   "b": 48.942
  },
  {
   "id": "f20",
   "text": "Os primeiros carros começaram a circular.",
   "a": 49.377,
   "b": 51.585
  },
  {
   "id": "f21",
   "text": "E cinco serviços abriram suas portas.",
   "a": 51.897,
   "b": 54.249
  },
  {
   "id": "f22",
   "text": "Esses dez moradores receberão um distintivo dourado de fundador para sempre.",
   "a": 54.558,
   "b": 59.496
  },
  {
   "id": "f23",
   "text": "Agora começa uma nova missão:",
   "a": 60.155,
   "b": 62.111
  },
  {
   "id": "f24",
   "text": "encontrar nossos primeiros moradores pioneiros.",
   "a": 62.519,
   "b": 65.379
  },
  {
   "id": "f25",
   "text": "Ainda temos catorze casas disponíveis.",
   "a": 65.72,
   "b": 68.139
  },
  {
   "id": "f26",
   "text": "Comente seu nome e sua profissão.",
   "a": 68.462,
   "b": 70.214
  },
  {
   "id": "f27",
   "text": "Quem será o próximo cidadão da SegueCity?",
   "a": 70.534,
   "b": 73.09
  }
 ],
