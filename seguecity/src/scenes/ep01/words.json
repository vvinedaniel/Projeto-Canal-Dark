{
 "fonte": "scripts/ep01-narracao.py",
 "frases": [
  {
   "id": "f01",
   "text": "Eu construí uma cidade inteira do zero.",
   "a": 0.15,
   "b": 2.81
  },
  {
   "id": "f02",
   "text": "Mas existe um pequeno problema…",
   "a": 3.5,
   "b": 5.84
  },
  {
   "id": "f03",
   "text": "Ninguém mora nela.",
   "a": 6.84,
   "b": 8.0
  },
  {
   "id": "f04",
   "text": "Tem casas, escola, hospital, comércio e até uma prefeitura.",
   "a": 9.4,
   "b": 14.06
  },
  {
   "id": "f05",
   "text": "Está tudo pronto, esperando pelos primeiros habitantes.",
   "a": 14.77,
   "b": 18.09
  },
  {
   "id": "f06",
   "text": "E é aqui que você entra.",
   "a": 19.1,
   "b": 20.52
  },
  {
   "id": "f07",
   "text": "A partir de hoje, cada novo seguidor poderá se tornar um cidadão da SegueCity.",
   "a": 21.36,
   "b": 26.2
  },
  {
   "id": "f08",
   "text": "Você poderá escolher seu nome, sua profissão e acompanhar seu personagem vivendo dentro dessa cidade.",
   "a": 26.92,
   "b": 32.94
  },
  {
   "id": "f09",
   "text": "Quer ser médico, policial, empresário, mecânico ou professor?",
   "a": 33.63,
   "b": 37.75
  },
  {
   "id": "f10",
   "text": "Nossa cidade precisa de pessoas de todas as profissões.",
   "a": 38.62,
   "b": 41.81
  },
  {
   "id": "f11",
   "text": "Conforme nossa população crescer, novos bairros serão construídos, empresas serão abertas e acontecimentos poderão mudar o destino da cidade.",
   "a": 42.61,
   "b": 51.07
  },
  {
   "id": "f12",
   "text": "Quando chegarmos aos cem seguidores, vamos liberar nossa primeira eleição.",
   "a": 52.09,
   "b": 56.35
  },
  {
   "id": "f13",
   "text": "E vocês poderão escolher quem vai governar a SegueCity.",
   "a": 57.0,
   "b": 60.07
  },
  {
   "id": "f14",
   "text": "Hoje começa nossa história.",
   "a": 61.33,
   "b": 63.0
  },
  {
   "id": "f15",
   "text": "Comente seu nome e sua profissão.",
   "a": 63.65,
   "b": 65.46
  },
  {
   "id": "f16",
   "text": "Quem será o primeiro morador da SegueCity?",
   "a": 66.12,
   "b": 68.57
  }
 ],
