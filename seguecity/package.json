{
  "name": "seguecity",
  "version": "0.1.0",
  "private": true,
  "description": "SegueCity — cidade virtual em pixel art 16-bit onde cada seguidor vira morador. Vídeos 9:16 (Remotion + Canvas 2D).",
  "scripts": {
    "preview": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "audio:build": "tsx scripts/audio/synth.ts",
    "stills": "tsx scripts/stills.ts",
    "render:demo": "tsx scripts/render.ts demo",
    "render:ep01": "tsx scripts/render.ts ep01",
    "validate": "tsx scripts/validate.ts",
    "narration:fit": "tsx scripts/narration-fit.ts",
    "city:status": "tsx scripts/city.ts status",
    "city:moradores": "tsx scripts/city.ts moradores",
    "residents:add": "tsx scripts/city.ts add",
    "residents:seed": "tsx scripts/city.ts seed",
    "residents:clear-test": "tsx scripts/city.ts limpar-teste",
    "check:signs": "tsx scripts/stills.ts Sandbox 0 --scale 0.25 --out out/stills/check --strict"
  },
  "dependencies": {
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
